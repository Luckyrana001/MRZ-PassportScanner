<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scanned_passport"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/result_success_badge"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="@string/scan_complete"
            android:textColor="@color/success_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/result_card_background"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scanned_item"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/holderNameValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/document_details"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/result_card_background"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <TextView style="@style/ResultLabel" android:text="@string/document_type_label" />
            <TextView android:id="@+id/documentTypeValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/first_name_label" />
            <TextView android:id="@+id/firstNameValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/middle_name_label" />
            <TextView android:id="@+id/middleNameValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/last_name_label" />
            <TextView android:id="@+id/lastNameValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/gender_label" />
            <TextView android:id="@+id/genderValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/document_number_label" />
            <TextView android:id="@+id/documentNumberValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/date_of_birth_label" />
            <TextView android:id="@+id/dateOfBirthValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/national_id_label" />
            <TextView android:id="@+id/nationalIdValue" style="@style/ResultValue" />

            <TextView style="@style/ResultLabel" android:text="@string/nationality_label" />
            <TextView android:id="@+id/nationalityValue" style="@style/ResultValue" />
        </LinearLayout>

        <TextView
            android:id="@+id/mrzImageLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/captured_mrz_image"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/mrzImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:background="@drawable/result_image_background"
            android:contentDescription="@string/captured_mrz_image"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/full_mrz"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/mrz_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/result_mrz_background"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <TextView
                android:id="@+id/mrzValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="320dp"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:typeface="monospace" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/primary_button"
            android:text="@string/scan_another_passport"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
